{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clef-playground",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // ページごとの OGP タグを差し込むため、ページの HTML も Worker を通す
    "run_worker_first": ["/api/*", "/", "/janken", "/avatar"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Clef の呼び出しは課金されるので IP ごとに回数を制限する
  "ratelimits": [
    {
      "name": "JANKEN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AVATAR_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
